      ],
      "parameters": {
        "jsCode": "const i=$('[A2] Iniciar medición').first().json;const v=$json.output||$json;let estado=v.estado_veredicto,score=Number(v.exactitud_factual),critica=String(v.critica||''),categoria=v.categoria_error;const intento=Number(i.intento||0);const tramite=['reclamo','reserva_sum'].includes(i.intencion);\nif(!['APROBADO','CORREGIR','ESCALAR'].includes(estado)||!Number.isInteger(score)||score<1||score>5)throw new Error('Veredicto inválido');\nif(estado==='APROBADO'&&score<4)estado='CORREGIR';\nif(tramite&&categoria==='alucinacion'&&estado==='APROBADO')estado='CORREGIR';\nif(intento>=2&&estado==='CORREGIR')estado='ESCALAR';\nif(/^\\s*no\\s+se\\b/i.test(String(i.respuesta_propuesta||'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,''))&&estado==='APROBADO'&&score===5)score=4;\nconst consulta=String(i.query||'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase();\nconst raices=[['amenaz','amenaza',false],['agred','agresión',false],['golpe','golpes',false],['violen','violencia',false],['arma','arma',false],['acos','acoso',false],['denunci','denuncia',false],['abogad','abogado',false],['juicio','juicio',false],['demand','demanda',false],['polici','policía',false],['gas','gas',true],['incendi','incendio',true],['humo','humo',true],['inund','inundación',true],['electrocut','electrocución',true]];\nconst borde=String.fromCharCode(92)+'b';const riesgos=raices.filter(([raiz])=>{const patron=raiz==='gas'?borde+'gas'+borde:raiz==='arma'?borde+'armas?'+borde:borde+raiz;return new RegExp(patron).test(consulta)});const riesgo=riesgos.find(([, ,emergencia])=>!emergencia||i.intencion!=='reclamo');if(riesgo){estado='ESCALAR';categoria='riesgo_legal_o_dinero';critica='Escalamiento obligatorio: '+riesgo[1]}\nif(tramite&&!riesgo){\n estado='APROBADO';\n if($json.error_juez){score=1;categoria='formato';critica='Observación (no bloquea): Falla del juez: '+String($json.error_juez)+' · pasa a la aprobación humana del worker';}\n else {score=Number(v.exactitud_factual);categoria=v.categoria_error;critica='Observación (no bloquea): '+String(v.critica||'');}\n}\nconst ti=Math.ceil((JSON.stringify(i).length+\"Sos el supervisor de calidad del asistente de un consorcio. Evaluás la respuesta propuesta SOLO contra la consulta del vecino y el contexto (fragmentos del reglamento con su fuente, resumen de memoria y fecha actual). No uses conocimiento externo. Criterios: (1) Exactitud: cada afirmación debe estar en el contexto; un dato inventado es alucinacion. (2) Si el dato no está en el contexto, la respuesta correcta empieza con 'No sé.' y ofrece derivar. (3) Clasificación: la intención debe coincidir con lo que el vecino pide; un relato o una pregunta NO es un reclamo si el vecino no pide registrarlo; un riesgo actual (gas, fuego, agua sobre electricidad, personas atrapadas) debe ser critico=true; para reservas, revisá que inicio y fin correspondan a la fecha relativa pedida. (4) Tono: español rioplatense con voseo, sin tú ni usted. Veredicto: APROBADO solo si exactitud ≥ 4 y no hay datos inventados ni errores de clasificación. CORREGIR si se puede mejorar usando el mismo contexto (escribí en critica qué cambiar, en una o dos frases accionables). ESCALAR ante riesgo legal, dinero o pagos puntuales, amenazas o violencia, conflicto entre vecinos, emergencia, o contexto insuficiente para responder bien. Devolvé solo el JSON pedido. Si la respuesta es 'No sé.' pero el contexto contiene información que responde la consulta, el veredicto es CORREGIR con categoria dato_faltante y exactitud ≤ 2. 'No sé.' merece APROBADO solo si el contexto realmente no cubre el tema. Si intencion es reclamo o reserva_sum, el mensaje final al vecino lo redacta después el sistema: evaluá SOLO la clasificación (intencion, categoria, prioridad, critico, inicio y fin según la fecha actual). No penalices que la respuesta diga que se registra, se envía a Administración o se deriva, ni exijas fragmentos del reglamento. Evaluá la clasificación solo con el mensaje actual.\".length)/4),to=Math.ceil(JSON.stringify(v).length/4);return [{json:{traceId:i.traceId,origen:i.origen,arquitectura:i.arquitectura,pregunta:i.query,respuesta:i.respuesta_propuesta,exactitud:score,veredicto:estado,critica,categoria_error:categoria,intento,tokens_entrada:ti,tokens_salida:to,costo_usd:Number(((ti*.15+to*.60)/1e6).toFixed(6)),latencia_ms:Date.now()-i._inicio,fecha:new Date().toISOString()}}];"
      },
      "onError": "continueErrorOutput"
    },
