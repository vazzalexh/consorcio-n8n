      "parameters": {
        "jsCode": "const v=JSON.parse(String($json.output).trim().replace(/^\\x60\\x60\\x60(?:json)?\\s*|\\x60\\x60\\x60$/g,''));\nif(!['consulta','reclamo','reserva','derivar'].includes(v.intencion)) throw Error('Intención inválida');\nconst req=$('[A2] Validar entrada').first().json;\nconst formato=/^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d$/;\nif(v.intencion==='reserva' && (!formato.test(v.inicio)||!formato.test(v.fin))) v.intencion='derivar';\nreturn [{json:{evento:req.evento,intencion:v.intencion,detalle:req.texto,inicio:v.inicio||'',fin:v.fin||'',respuesta:String(v.respuesta||'Consultar a Administración.').slice(0,500),urgente:v.urgente===true}}];"
