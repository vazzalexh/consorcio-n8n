      "parameters": {
        "jsCode": "const req=$('[A2] Validar entrada').first().json;\nif($input.all().some(x=>Object.keys(x.json).length && (!x.json.id || !x.json.fields || !x.json.createdTime))) throw Error('Respuesta de consultas mal formada');\nconst now=Date.now();\nconst rows=$input.all().map(x=>x.json).filter(x=>x.id && x.fields && x.fields.Name && x.createdTime);\nconst own=rows.filter(r=>String(r.fields.Name).startsWith(req.persona+'_'));\nconst duplicate=rows.some(r=>r.fields.Name===req.evento);\nconst minute=own.filter(r=>now-Date.parse(r.createdTime)<60000).length;\nreturn [{json:{estado:!duplicate && minute<5 && own.length<40 && rows.length<100?'ok':'cupo'}}];"
      },
