      "parameters": {
        "jsCode": "const a=$input.all().map(x=>x.json); const rows=a.filter(r=>r.id && r.fields?.activo && Array.isArray(r.fields.unidad) && r.fields.unidad.length===1); if(a.some(r=>Object.keys(r).length && (!r.id || !r.fields))) throw Error('Respuesta de usuarios mal formada'); if(rows.length>1) throw Error('Más de un vecino activo coincide'); return [{json:{registrado:rows.length===1,...(rows.length?{usuario:rows[0].id,unidad:rows[0].fields.unidad[0]}:{})}}];"
