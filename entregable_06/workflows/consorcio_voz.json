      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        180
      ],
      "parameters": {
        "jsCode": "let s=String($json.texto||'').replace(/^\\s*Fuente:.*$/gim,'').replace(/https?:\\/\\/\\S+|www\\.\\S+/gi,'').replace(/\\([^)]*(?:art[ií]culo|secci[oó]n|fuente|reglamento|\\.md)[^)]*\\)/gi,'').replace(/[\\p{Extended_Pictographic}\\uFE0F\\u200D]/gu,'').replace(/[#*•▪◦]/g,'').replace(/^\\s*[-–—]\\s+/gm,'').replace(/\\s+/g,' ').trim();if(s.length>200){let cut=s.slice(0,201);let p=cut.lastIndexOf('. ');if(p>=40){s=cut.slice(0,p+1).trim();}else{p=cut.lastIndexOf(' ');s=cut.slice(0,p>0?p:200).trim();}}return [{json:{texto:s}}];"
      },
      "onError": "continueErrorOutput"
    },
