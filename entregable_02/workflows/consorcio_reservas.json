    {
      "id": "a97636ca-a8b4-4768-a238-f9a328286fda",
      "name": "[B2] Comprobar solapamiento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "jsCode": "const r=$('[A1] Entrada').first().json; const all=$input.all().map(x=>x.json); const hh=/^([01]\\d|2[0-3]):[0-5]\\d$/; let conflicto=null; for(const row of all){ if(Object.keys(row).length===0)continue; if(!row.id||!row.fields||!hh.test(row.fields.hora_inicio||'')||!hh.test(row.fields.hora_fin||'')||row.fields.hora_inicio>=row.fields.hora_fin)throw Error('Reserva del día mal formada'); const f=row.fields; const mismo=r.operacion==='registrar'&&r.evento&&f.id_reserva===r.evento&&f.fecha===r.inicio.slice(0,10)&&f.hora_inicio===r.inicio.slice(11,16)&&f.hora_fin===r.fin.slice(11,16)&&Array.isArray(f.usuario)&&f.usuario.includes(r.usuario)&&Array.isArray(f.unidad)&&f.unidad.includes(r.unidad); if(!mismo&&f.hora_inicio<r.fin.slice(11,16)&&f.hora_fin>r.inicio.slice(11,16)){conflicto={inicio:f.hora_inicio,fin:f.hora_fin};break;} } return [{json:{disponible:!conflicto,conflicto}}];"
      },
      "onError": "continueErrorOutput"
    },
