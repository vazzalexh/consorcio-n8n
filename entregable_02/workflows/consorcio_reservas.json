      ],
      "parameters": {
        "jsCode": "const r=$('[A1] Entrada').first().json; if(!['evento','usuario','unidad','aprobado_por'].every(k=>typeof r[k]==='string'&&r[k].trim())) throw Error('Faltan datos de registro o aprobación'); const a=$input.all().map(i=>i.json); if(a.length===1&&Object.keys(a[0]).length===0)return [{json:{}}]; if(a.length!==1||!a[0].id||!a[0].fields||a[0].fields.id_reserva!==r.evento)throw Error('Resultado de búsqueda inválido o duplicado');const f=a[0].fields;if(f.fecha!==r.inicio.slice(0,10)||f.hora_inicio!==r.inicio.slice(11,16)||f.hora_fin!==r.fin.slice(11,16)||!f.usuario?.includes(r.usuario)||!f.unidad?.includes(r.unidad)||f.estado!=='Confirmada')throw Error('El evento ya pertenece a otra reserva');return [{json:a[0]}];"
