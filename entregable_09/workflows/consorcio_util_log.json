      "id": "cc17236e-234f-4241-b276-94416685c277",
      "name": "[A1] Armar registro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "jsCode": "const j=$json;\nconst clean=x=>{\n let s=String(x??'').replace(/[\\uE000\\uE001]/g,'');const saved=[];\n const protect=(re)=>{s=s.replace(re,v=>{const i=saved.push(v)-1;return '\\uE000'+i+'\\uE001'})};\n protect(/(?<![A-Za-z0-9_])\\d+-\\d+_\\d+(?![A-Za-z0-9_])/g);\n protect(/(?<![\\d.])\\d+\\.\\d+(?![\\d.])/g);\n s=s.replace(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi,'[dato]').replace(/(?:\\+?\\d[\\d\\s().-]{6,}\\d)/g,'[dato]').replace(/\\b\\d{1,3}(?:\\.\\d{3}){2}\\b/g,'[dato]');\n return s.replace(/\\uE000(\\d+)\\uE001/g,(_,i)=>saved[Number(i)]??'').slice(0,500);\n};\nconst raw=j.confidenceScore; const n=raw===''||raw===null||raw===undefined?null:Number(raw);\nconst entry={traceId:String(j.traceId||('sin-traceId-'+$execution.id)),timestamp:$now.setZone('America/Argentina/Buenos_Aires').toISO(),workflow:String(j.workflow||''),nodeName:String(j.nodeName||''),evento_log:String(j.evento_log||''),toolOutput:clean(typeof j.toolOutput==='string'?j.toolOutput:JSON.stringify(j.toolOutput??'')),systemPromptSnapshot:String(j.systemPromptSnapshot||'n/a'),confidenceScore:Number.isFinite(n)?n:null,veredicto:['APROBADO','CORREGIR','ESCALAR'].includes(j.veredicto)?j.veredicto:'',resultado:['success','error','pending'].includes(j.resultado)?j.resultado:'error'};\nconst fields={...entry,json:JSON.stringify(entry),canal_origen:'Telegram'};\nif(fields.confidenceScore===null)delete fields.confidenceScore;\nif(!fields.veredicto)delete fields.veredicto;\nreturn [{json:fields}];"
      },
      "onError": "continueErrorOutput"
    },
